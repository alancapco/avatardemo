LIVEAVATAR_API_KEY=your_liveavatar_api_key
LIVEAVATAR_AVATAR_ID=your_liveavatar_avatar_id
LIVEAVATAR_CONTEXT_ID=your_liveavatar_context_id
LIVEAVATAR_RPQ_CONTEXT_ID=
LIVEAVATAR_VOICE_ID=
LIVEAVATAR_LANGUAGE=en
LIVEAVATAR_SANDBOX=false

# Required for question generation + interview analysis (OpenAI or OpenAI-compatible)
CUSTOM_LLM_API_KEY=your_llm_api_key
CUSTOM_LLM_MODEL=gpt-4o-mini
CUSTOM_LLM_BASE_URL=https://api.openai.com/v1
CUSTOM_LLM_DISPLAY_NAME=Capco Interview LLM
CUSTOM_LLM_SECRET_TYPE=OPENAI_API_KEY

# Written by npm run liveavatar:setup-llm (optional; enables custom LLM on LiveAvatar voice)
LIVEAVATAR_LLM_SECRET_ID=
LIVEAVATAR_LLM_CONFIGURATION_ID=

# Coach v2 — Tavus Conversational Video Interface (server-only)
TAVUS_API_KEY=your_tavus_api_key
TAVUS_PAL_ID=
TAVUS_FACE_ID=r3f4182ef554
